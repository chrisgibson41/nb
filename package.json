{
  "name": "obsidian-notes",
  "version": "0.1.0",
  "description": "Local markdown note-taking app",
  "scripts": {
    "dev": "concurrently -k \"node server.js --config config.json\" \"cd client && npm run dev\"",
    "build": "cd client && npm run build",
    "start": "bash run.sh",
    "install:all": "npm install && cd client && npm install",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:unit": "cd client && npm run test:run",
    "test:e2e": "npx playwright test",
    "test:all": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@resvg/resvg-js": "^2.6.2",
    "concurrently": "^8.2.2",
    "wait-on": "^9.0.5"
  }
}
